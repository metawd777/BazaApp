<style>
:root {
  --bg: #10130e; --fg: #eceee8; --card: #181c16; --muted: #1e231c;
  --muted-fg: #8a8f86; --ok: #8fb584; --warn: #c8946e; --border: #2a2d2a;
  --shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
}
html[data-theme="light"] {
  --bg: #f1efe4; --fg: #1c1d1a; --card: #fffcf4; --muted: #e6e2d4;
  --muted-fg: #5c6058; --ok: #2f6b38; --warn: #a05a38; --border: #d4d0c2;
  --shadow: 0 0 0 1px rgb(28 29 26 / 0.1);
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100dvh; background: var(--bg); color: var(--fg);
  font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif; }
button, [role="button"] { cursor: pointer; font: inherit; color: inherit; }
button:disabled { opacity: .4; }
input, textarea { font: inherit; color: inherit; background: var(--muted); border: 0; border-radius: 8px; }
.shell {
  min-height: 100dvh; max-width: 430px; margin: 0 auto;
  padding: max(12px, env(safe-area-inset-top)) 16px calc(128px + env(safe-area-inset-bottom));
  background:
    radial-gradient(780px 360px at 50% -80px, color-mix(in oklab, var(--ok) 26%, transparent), transparent 70%),
    var(--bg);
}
header { display: flex; align-items: center; justify-content: space-between; }
.logo { font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: 28px; letter-spacing: .22em; text-decoration: none; color: inherit; }
h1 { font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: 36px; letter-spacing: .04em; margin: 8px 0 12px; font-weight: 600; }
h2 { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted-fg); margin: 18px 0 8px; }
.card { background: var(--card); border-radius: 14px; box-shadow: var(--shadow); padding: 14px; }
.muted { color: var(--muted-fg); font-size: 14px; line-height: 1.5; }
.row { display: flex; gap: 8px; align-items: center; }
.btn { min-height: 44px; border: 0; border-radius: 10px; background: var(--fg); color: var(--bg); padding: 0 14px; font-weight: 600; }
.btn.ghost { background: var(--muted); color: var(--fg); }
.btn.ok { background: color-mix(in oklab, var(--ok) 30%, var(--muted)); color: var(--fg); }
.btn.full { width: 100%; }
.grid { display: grid; gap: 8px; }
.cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal b { text-align: center; font-size: 11px; color: var(--muted-fg); font-weight: 500; padding: 6px 0; }
.day { min-height: 48px; border: 0; border-radius: 10px; background: transparent; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
.day.on { background: var(--card); box-shadow: var(--shadow); }
.day .mark { font-size: 10px; font-weight: 700; color: var(--ok); }
nav.tab {
  position: fixed; left: 12px; right: 12px; z-index: 30;
  bottom: calc(10px + env(safe-area-inset-bottom));
  max-width: 406px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;
}
nav.tab a {
  display: flex; align-items: center; justify-content: center;
  min-height: 52px; border-radius: 14px;
  background: var(--card); box-shadow: var(--shadow);
  text-align: center; font-size: 13px; font-weight: 600;
  color: var(--muted-fg); text-decoration: none;
}
nav.tab a.active { background: var(--fg); color: var(--bg); }
.sets { display: grid; gap: 6px; margin-top: 8px; }
.set { display: grid; grid-template-columns: 44px 1fr 1fr 40px 36px; gap: 5px; align-items: center; }
.set input { height: 42px; text-align: center; width: 100%; }
.check { height: 42px; border: 0; border-radius: 8px; background: var(--muted); }
.check.on { background: var(--ok); color: var(--bg); }
.del { height: 42px; border: 0; border-radius: 8px; background: transparent; color: var(--muted-fg); font-size: 20px; }
.timer {
  position: fixed; left: 12px; right: 12px; z-index: 40;
  bottom: calc(74px + env(safe-area-inset-bottom));
  max-width: 406px; margin: 0 auto;
  background: var(--card);
  border-radius: 16px; box-shadow: var(--shadow); padding: 10px;
}
.chips { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 6px; }
.chip { height: 48px; border: 0; border-radius: 8px; background: color-mix(in oklab, var(--ok) 18%, var(--muted));
  font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: 20px; }
.alert {
  position: fixed; inset: 0; z-index: 60; background: color-mix(in oklab, var(--bg) 88%, transparent);
  backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 20px;
}
.alert .box { width: min(400px, 100%); background: var(--card); color: var(--fg); border-radius: 18px; padding: 22px; box-shadow: var(--shadow); }
.big { font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: 42px; margin: 6px 0 12px; }
.hidden { display: none !important; }
.ico { width: 44px; height: 44px; border: 0; background: transparent; color: var(--muted-fg); font-size: 18px; }
.ex { margin-bottom: 10px; }
.ex h3 { margin: 0; font-size: 18px; }
.note { width: 100%; min-height: 44px; padding: 10px; margin-top: 8px; }
.kind { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px;
  background: color-mix(in oklab, var(--ok) 25%, var(--muted)); }
</style>
</head>
